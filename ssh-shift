    def _toggle_advanced(self, expanded: bool) -> None:
        self.advanced_panel.setVisible(expanded)
        self.advanced_button.setArrowType(
            Qt.ArrowType.DownArrow if expanded else Qt.ArrowType.RightArrow
        )
        self.adjustSize()

    def _browse_identity(self) -> None:
        path, _ = QFileDialog.getOpenFileName(
            self,
            "Choose an SSH identity file",
            str(Path.home() / ".ssh"),
            "All files (*)",
        )
        if path:
            self.identity_file.setText(path)

    def _request(self, check_identity: bool = True) -> ConnectionRequest:
        endpoint, embedded_username = parse_destination(self.host.text())
        field_username = validate_username(self.username.text())
        if embedded_username and field_username and embedded_username != field_username:
            raise SSHShiftError(
                "The Host and Username fields specify different usernames."
            )
        username = field_username or embedded_username
        identity_file = self.identity_file.text().strip()
        if identity_file:
            identity_path = Path(identity_file).expanduser()
            if check_identity and not identity_path.is_file():
                raise SSHShiftError("The selected identity file does not exist.")
            identity_file = str(identity_path)

        jump = None
        jump_username = ""
        if self.jump_host.text().strip():
            jump, embedded_jump_username = parse_destination(self.jump_host.text())
            field_jump_username = validate_username(
                self.jump_username.text(), "jump username"
            )
            if (
                embedded_jump_username
                and field_jump_username
                and embedded_jump_username != field_jump_username
            ):
                raise SSHShiftError(
                    "The Jump host and Jump username fields specify different "
                    "usernames."
                )
            jump_username = field_jump_username or embedded_jump_username
        elif self.jump_username.text().strip():
            raise SSHShiftError("Enter a Jump host or clear the Jump username.")

        return ConnectionRequest(
            endpoint,
            ConnectionOptions(
                username=username,
                identity_file=identity_file,
                jump=jump,
                jump_username=jump_username,
                forward_agent=self.forward_agent.isChecked(),
                forward_x11=self.forward_x11.isChecked(),
            ),
        )

    def _update_preview(self) -> None:
        try:
            preview = equivalent_command(self._request(check_identity=False))
        except SSHShiftError:
            preview = "Enter a valid host to preview the command."
        self.command_preview.setText(preview)

    def _validate_and_accept(self) -> None:
        try:
            self._request()
        except SSHShiftError as error:
            QMessageBox.warning(self, TITLE, str(error))
            return
        self.accept()

    def values(self) -> ConnectionRequest:
        return self._request()


def get_connection() -> ConnectionRequest:
    qt_application()
    dialog = ConnectionDialog()
    if dialog.exec() != QDialog.DialogCode.Accepted:
        raise SystemExit(0)
    return dialog.values()


def show_error(message: str) -> None:
    qt_application()
    QMessageBox.critical(None, TITLE, message)


def kwallet_interface() -> tuple[dbus.Interface, str]:
    bus = dbus.SessionBus()
    last_error: dbus.DBusException | None = None
    for service, object_path in KWALLET_SERVICES:
        try:
            obj = bus.get_object(service, object_path)
            wallet = dbus.Interface(obj, "org.kde.KWallet")
            wallet_name = str(wallet.localWallet())
            if not wallet_name:
                raise SSHShiftError("KDE Wallet did not report a local wallet.")
            return wallet, wallet_name
        except dbus.DBusException as exc:
            last_error = exc
    raise SSHShiftError("KDE Wallet is unavailable.") from last_error


def wallet_key() -> bytes:
    try:
        wallet, wallet_name = kwallet_interface()
        handle = int(wallet.open(wallet_name, 0, WALLET_APP_ID))
        if handle < 0:
            raise SSHShiftError("KDE Wallet could not be opened.")
        if not wallet.hasFolder(handle, WALLET_FOLDER, WALLET_APP_ID):
            if not wallet.createFolder(handle, WALLET_FOLDER, WALLET_APP_ID):
                raise SSHShiftError(
                    "The SSHShift folder could not be created in KDE Wallet."
                )

        if wallet.hasEntry(handle, WALLET_FOLDER, WALLET_ENTRY, WALLET_APP_ID):
            value = str(
                wallet.readPassword(handle, WALLET_FOLDER, WALLET_ENTRY, WALLET_APP_ID)
            )
        else:
            value = secrets.token_hex(32)
            result = int(
                wallet.writePassword(
                    handle,
                    WALLET_FOLDER,
                    WALLET_ENTRY,
                    value,
                    WALLET_APP_ID,
                )
            )
            if result != 0:
                raise SSHShiftError(
                    "The SSHShift privacy key could not be saved in KDE Wallet."
                )
    except dbus.DBusException as exc:
        raise SSHShiftError("KDE Wallet is unavailable.") from exc

    if not re.fullmatch(r"[0-9a-f]{64}", value):
        raise SSHShiftError("The SSHShift privacy key in KDE Wallet is invalid.")
    return bytes.fromhex(value)


def opaque_host_alias(key: bytes, endpoint: Endpoint) -> str:
    digest = hmac.new(
        key,
        b"ssh-shift-host-v1\0" + endpoint.identity.encode(),
        hashlib.sha256,
    ).hexdigest()
    return f"ssh-shift-{digest}"


def known_hosts_path() -> Path:
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    directory = data_home / "ssh-shift"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    known_hosts = directory / "known_hosts"
    known_hosts.touch(mode=0o600, exist_ok=True)
    os.chmod(known_hosts, 0o600)
    return known_hosts


def known_hosts_lock_path() -> Path:
    return known_hosts_path().with_name("known_hosts.lock")


def known_hosts_token(endpoint: Endpoint) -> str:
    if endpoint.port == 22:
        return endpoint.host
    return f"[{endpoint.host}]:{endpoint.port}"


def trust_mappings(
    request: ConnectionRequest, key: bytes
) -> list[tuple[str, str]]:
    endpoints = [request.endpoint]
    if request.options.jump is not None:
        endpoints.append(request.options.jump)
    mappings = []
    for endpoint in endpoints:
        mapping = (known_hosts_token(endpoint), opaque_host_alias(key, endpoint))
        if mapping not in mappings:
            mappings.append(mapping)
    return mappings


def known_host_field(line: str) -> str:
    fields = line.split()
    if not fields:
        return ""
    return fields[1] if fields[0].startswith("@") and len(fields) > 1 else fields[0]


def replace_known_host_field(line: str, value: str) -> str:
    fields = line.split(maxsplit=3)
    if not fields:
        return line
    index = 1 if fields[0].startswith("@") else 0
    if index >= len(fields):
        raise SSHShiftError("The known-host database contains an invalid entry.")
    fields[index] = value
    return " ".join(fields)


def find_known_host_lines(path: Path, alias: str) -> list[str]:
    result = subprocess.run(
        [SSH_KEYGEN, "-F", alias, "-f", str(path)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode not in (0, 1):
        raise SSHShiftError("The known-host database could not be read.")
    return [
        line
        for line in result.stdout.splitlines()
        if line.strip() and not line.startswith("#")
    ]


def prepare_session_known_hosts(
    request: ConnectionRequest,
    key: bytes,
    directory: Path,
) -> tuple[Path, list[tuple[str, str]]]:
    persistent = known_hosts_path()
    mappings = trust_mappings(request, key)
    lines: list[str] = []
    for token, alias in mappings:
        for line in find_known_host_lines(persistent, alias):
            translated = replace_known_host_field(line, token)
            if translated not in lines:
                lines.append(translated)

    runtime = directory / "known_hosts"
    runtime.write_text("".join(f"{line}\n" for line in lines), encoding="utf-8")
    os.chmod(runtime, 0o600)
    return runtime, mappings


def persist_session_known_hosts(
    runtime: Path,
    mappings: list[tuple[str, str]],
) -> None:
    if not runtime.exists():
        return
    try:
        runtime_lines = [
            line
            for line in runtime.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except (OSError, UnicodeError) as exc:
        raise SSHShiftError("The temporary known-host data could not be read.") from exc

    replacements: dict[str, list[str]] = {}
    for token, alias in mappings:
        translated = []
        for line in runtime_lines:
            if known_host_field(line) == token:
                opaque = replace_known_host_field(line, alias)
                if opaque not in translated:
                    translated.append(opaque)
        if translated:
            replacements[alias] = translated
    if not replacements:
        return

    persistent = known_hosts_path()
    lock_path = known_hosts_lock_path()
    with lock_path.open("a+", encoding="utf-8") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            current = persistent.read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeError) as exc:
            raise SSHShiftError("The known-host database could not be read.") from exc

        matched = {
            line
            for alias in replacements
            for line in find_known_host_lines(persistent, alias)
        }
        updated = [line for line in current if line not in matched]
        for alias in replacements:
            for line in replacements[alias]:
                if line not in updated:
                    updated.append(line)

        descriptor, temporary_name = tempfile.mkstemp(
            prefix=".known_hosts.", dir=persistent.parent
        )
        temporary = Path(temporary_name)
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8") as output:
                output.write("".join(f"{line}\n" for line in updated))
                output.flush()
                os.fsync(output.fileno())
            os.chmod(temporary, 0o600)
            os.replace(temporary, persistent)
        finally:
            temporary.unlink(missing_ok=True)


def ssh_config_quote(value: str) -> str:
    if "\0" in value or "\n" in value or "\r" in value:
        raise SSHShiftError("A connection value contains unsupported characters.")
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def host_config_lines(
    alias: str,
    endpoint: Endpoint,
    username: str,
    known_hosts: Path,
    *,
    identity_file: str = "",
    forward_agent: bool = False,
    forward_x11: bool = False,
) -> list[str]:
    lines = [
        f"Host {alias}",
        f"    HostName {ssh_config_quote(endpoint.host)}",
        f"    Port {endpoint.port}",
        f"    UserKnownHostsFile {ssh_config_quote(str(known_hosts))}",
        "    HashKnownHosts no",
        "    StrictHostKeyChecking ask",
        "    CheckHostIP no",
        "    UpdateHostKeys yes",
        f"    ForwardAgent {'yes' if forward_agent else 'no'}",
        f"    ForwardX11 {'yes' if forward_x11 else 'no'}",
        "    ForwardX11Trusted no",
        "    ExitOnForwardFailure yes",
        "    AddKeysToAgent no",
        "    ControlMaster no",
        "    PermitLocalCommand no",
    ]
    if username:
        lines.append(f"    User {ssh_config_quote(username)}")
    if identity_file:
        lines.extend(
            (
                f"    IdentityFile {ssh_config_quote(identity_file)}",
                "    IdentitiesOnly yes",
            )
        )
    return lines


def build_ssh_config(
    request: ConnectionRequest,
    known_hosts: Path,
) -> str:
    options = request.options
    sections: list[list[str]] = []
    if options.jump is not None:
        sections.append(
            host_config_lines(
                JUMP_ALIAS,
                options.jump,
                options.jump_username,
                known_hosts,
            )
        )

    target = host_config_lines(
        TARGET_ALIAS,
        request.endpoint,
        options.username,
        known_hosts,
        identity_file=options.identity_file,
        forward_agent=options.forward_agent,
        forward_x11=options.forward_x11,
    )
    if options.jump is not None:
        target.append(f"    ProxyJump {JUMP_ALIAS}")
    sections.append(target)
    return "\n\n".join("\n".join(section) for section in sections) + "\n"


def private_runtime_directory() -> Path:
    runtime_base = Path(f"/run/user/{os.getuid()}")
    if not runtime_base.is_dir() or runtime_base.stat().st_uid != os.getuid():
        raise SSHShiftError("The private per-user runtime directory is unavailable.")
    directory = Path(tempfile.mkdtemp(prefix="ssh-shift-", dir=runtime_base))
    os.chmod(directory, 0o700)
    return directory


def write_runtime_config(directory: Path, content: str) -> Path:
    path = directory / "ssh_config"
    path.write_text(content, encoding="utf-8")
    os.chmod(path, 0o600)
    return path


def validate_internal_config(path_text: str) -> Path:
    try:
        path = Path(path_text).resolve(strict=True)
    except OSError as exc:
        raise SSHShiftError("The private SSH configuration is unavailable.") from exc
    runtime_base = Path(f"/run/user/{os.getuid()}").resolve()
    if (
        path.name != "ssh_config"
        or path.parent.parent != runtime_base
        or not path.parent.name.startswith("ssh-shift-")
        or path.stat().st_uid != os.getuid()
        or path.parent.stat().st_uid != os.getuid()
        or path.stat().st_mode & 0o077
        or path.parent.stat().st_mode & 0o077
    ):
        raise SSHShiftError("The private SSH configuration failed its safety check.")
    return path


def start_session(config: Path) -> subprocess.Popen:
    config = validate_internal_config(str(config))
    try:
        return subprocess.Popen(
            [
                KONSOLE,
                "--separate",
                "-p",
                "LocalTabTitleFormat=SSHShift",
                "-p",
                "RemoteTabTitleFormat=SSHShift",
                "-e",
                SSH,
                "-F",
                str(config),
                TARGET_ALIAS,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        raise SSHShiftError("Konsole could not be started.") from exc


def process_has_child(process: subprocess.Popen) -> bool:
    try:
        children = Path(
            f"/proc/{process.pid}/task/{process.pid}/children"
        ).read_text(encoding="ascii")
    except OSError:
        return False
    return bool(children.strip())


def wait_for_session(process: subprocess.Popen) -> int:
    """Show feedback until Konsole starts OpenSSH, then wait for the session."""
    qt_application()
    progress = QProgressDialog(
        "Starting Konsole and handing the connection to OpenSSH…\n"
        "The first Konsole launch can take a little while.",
        "Cancel",
        0,
        0,
    )
    progress.setWindowTitle(TITLE)
    progress.setWindowIcon(QIcon.fromTheme("utilities-terminal"))
    progress.setWindowModality(Qt.WindowModality.ApplicationModal)
    progress.setMinimumDuration(0)
    progress.setAutoClose(False)
    progress.setAutoReset(False)
    progress.show()

    loop = QEventLoop()
    timer = QTimer()
    timer.setInterval(100)

    def poll() -> None:
        if progress.wasCanceled():
            process.terminate()
            loop.quit()
        elif process.poll() is not None or process_has_child(process):
            loop.quit()

    timer.timeout.connect(poll)
    timer.start()
    loop.exec()
    timer.stop()
    canceled = progress.wasCanceled()
    progress.close()
    if canceled:
        try:
            return process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            return process.wait()
    return process.wait()


def main() -> int:
    if sys.argv[1:] in (["--version"], ["-V"]):
        print(f"SSHShift {VERSION}")
        return 0
    if sys.argv[1:] in (["--help"], ["-h"]):
        print("usage: ssh-shift [--help] [--version]")
        return 0
    if len(sys.argv) > 1:
        print("ssh-shift: unexpected command-line arguments", file=sys.stderr)
        return 2
    if not Path(SSH).is_file():
        raise SSHShiftError("OpenSSH client is not installed.")
    if not Path(KONSOLE).is_file():
        raise SSHShiftError("Konsole is not installed.")

    request = get_connection()
    key = wallet_key()
    runtime_directory = private_runtime_directory()
    runtime_known_hosts: Path | None = None
    mappings: list[tuple[str, str]] = []
    try:
        runtime_known_hosts, mappings = prepare_session_known_hosts(
            request, key, runtime_directory
        )
        config = write_runtime_config(
            runtime_directory,
            build_ssh_config(request, runtime_known_hosts),
        )
        return wait_for_session(start_session(config))
    finally:
        try:
            if runtime_known_hosts is not None:
                persist_session_known_hosts(runtime_known_hosts, mappings)
        finally:
            shutil.rmtree(runtime_directory, ignore_errors=True)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SSHShiftError as error:
        show_error(str(error))
        raise SystemExit(1) from None
